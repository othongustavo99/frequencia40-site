---
import '../styles/global.css';
import { company, whatsappUrl } from '../data/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  structuredData?: boolean;
}
const {
  title,
  description = company.description,
  noindex = false,
  structuredData = false,
} = Astro.props;

// Sem domínio configurado: sem canonical e sem metadados sociais com URL falsa.
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL('/images/social-preview.png', Astro.site).href : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: company.legalDisplay,
  description: company.description,
  telephone: `+${company.whatsappDigits}`,
  areaServed: [
    { '@type': 'City', name: company.city },
    { '@type': 'AdministrativeArea', name: 'Região Bragantina, São Paulo' },
  ],
  availableLanguage: 'pt-BR',
  ...(Astro.site ? { url: Astro.site.href } : {}),
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090a0b" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || !Astro.site ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:type" content="image/png" />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content="Frequência40 — Desenvolvimento e Tecnologia. Programando o futuro." />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="format-detection" content="telephone=no" />
    {Astro.site && <link rel="sitemap" href={new URL('/sitemap.xml', Astro.site).href} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#principal">Pular para o conteúdo</a>
    <slot />
    <a class="mobile-quick-contact" href={whatsappUrl()} target="_blank" rel="noopener noreferrer" aria-label="Conversar com a Frequência40 pelo WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.6a8.8 8.8 0 0 1-9.3 8.5 9.4 9.4 0 0 1-3.4-1l-5.2 1.3 1.4-5a8.7 8.7 0 0 1-1.1-4A8.8 8.8 0 0 1 12 2.6 8.8 8.8 0 0 1 21 11.6Z"/><path d="M8 8.5c.2 2.5 3 5.6 5.7 6.1.7.1 1.6-1.2 2-1.3"/></svg>
    </a>
    <script>
      const prefersLessMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersLessMotion && 'IntersectionObserver' in window) {
        const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
        const observer = new IntersectionObserver((entries, instance) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            instance.unobserve(entry.target);
          });
        }, { threshold: 0.08, rootMargin: '0px 0px 45px 0px' });
        elements.forEach((element) => observer.observe(element));
        document.documentElement.classList.add('can-reveal');
      }
    </script>
  </body>
</html>
