---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import AppStoreDemoPair from '../../components/AppStoreDemoPair.astro';
import { servicePages, type FullServicePage, getServicePage, serviceUrl } from '../../data/service-pages';
import { services, whatsappUrl } from '../../data/site';

export function getStaticPaths() {
  return servicePages.map((item) => ({
    params: { slug: item.slug },
    props: { page: getServicePage(item.slug)! },
  }));
}

interface Props { page: FullServicePage }
const { page } = Astro.props;
const { service } = page;
const proposalUrl = `/orcamento/?servico=${encodeURIComponent(service.name)}`;
const selectedIndex = services.findIndex((item) => item.id === service.id);
const otherPages = servicePages.filter((item) => item.slug !== page.slug);
const related = [otherPages[selectedIndex % otherPages.length], otherPages[(selectedIndex + 4) % otherPages.length], otherPages[(selectedIndex + 7) % otherPages.length]]
  .filter((item, index, items) => items.findIndex((entry) => entry.slug === item.slug) === index);
const imagePath = `/images/servicos/${page.slug}.svg`;
const faq = [
  ...page.faq,
  { q: 'A solução precisa seguir um modelo pronto?', a: 'Não. Avaliamos a estrutura atual da empresa, o que realmente precisa ser resolvido e os recursos mais adequados. O escopo é definido antes do desenvolvimento.' },
];
---
<BaseLayout
  title={`${service.name} | Soluções para empresas | Frequência40`}
  description={`${page.intro.slice(0, 150)} Conheça aplicações para Bragança Paulista e região.`}
>
  <Header />
  <main id="principal">
    <section class="detail-hero" aria-labelledby="detail-title">
      <div class="container">
        <nav class="detail-breadcrumb" aria-label="Caminho de navegação"><a href="/">Início</a><span aria-hidden="true">/</span><a href="/#servicos">Serviços</a><span aria-hidden="true">/</span><span aria-current="page">{service.name}</span></nav>
        <div class="detail-hero__layout">
          <div class="detail-hero__intro">
            <div class="detail-overline"><span class="detail-icon"><ServiceIcon name={service.icon} size={23} /></span><span>{page.eyebrow}</span><span class="detail-id">/ {service.id}</span></div>
            <h1 id="detail-title">{page.headline}</h1>
            <p class="detail-lead">{page.intro}</p>
            <p class="detail-promise"><span aria-hidden="true">✦</span>{page.promise}</p>
            <div class="detail-actions"><a class="btn btn--gold" href="#aplicacoes">Onde aplicar <span aria-hidden="true">↗</span></a><a class="btn btn--ghost" href="#demonstracao">Ver demonstração <span aria-hidden="true">↗</span></a></div>
          </div>
          <div class="detail-hero__art" aria-label={`Demonstração visual de ${service.name}`}>
            {page.serviceId === '01' ? (
              <AppStoreDemoPair variant="section" showCaptions={true}/>
            ) : (
              <img src={imagePath} width="1200" height="780" alt={page.imageDescription} loading="eager" decoding="async" />
            )}
            <p class="detail-art-note">DEMONSTRAÇÃO CONCEITUAL · DADOS ILUSTRATIVOS</p>
          </div>
        </div>
      </div>
    </section>

    <nav class="detail-anchor-nav" aria-label="Navegar nesta solução"><div class="container detail-anchor-nav__inner">
      <a href="#beneficios">Benefícios</a><a href="#aplicacoes">Onde aplicar</a><a href="#demonstracao">Demonstração</a><a href="#implantacao">Como funciona</a><a href="#contato">Solicitar proposta</a>
    </div></nav>

    <section class="detail-section" id="beneficios" aria-labelledby="benefits-heading">
      <div class="container">
        <div class="detail-heading"><div><span class="eyebrow">O QUE A SOLUÇÃO AJUDA A RESOLVER</span><h2 id="benefits-heading">Tecnologia que faz <span class="highlight">sentido na rotina.</span></h2></div><p>Um projeto útil começa pela operação da empresa, não por uma lista de recursos desnecessários.</p></div>
        <div class="benefits-grid">
          {page.benefits.map((item, i) => <article class="benefit-card"><span class="benefit-card__num">0{i+1} /</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="detail-section detail-section--muted" id="aplicacoes" aria-labelledby="applications-heading">
      <div class="container">
        <div class="detail-heading"><div><span class="eyebrow">PARA NEGÓCIOS DIFERENTES</span><h2 id="applications-heading">Como aplicar <span class="highlight">na sua empresa.</span></h2></div><p>A tecnologia se adapta à necessidade — seja de uma loja, clínica, oficina, escritório ou outro empreendimento.</p></div>
        <div class="application-grid">
          {page.applications.map((application, i) => <article class="application-card"><div class="application-card__index"><span>{String(i+1).padStart(2,'0')}</span><span aria-hidden="true">↗</span></div><h3>{application.name}</h3><p>{application.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="detail-section" id="demonstracao" aria-labelledby="demo-heading">
      <div class="container detail-demo-grid">
        <div class="detail-demo-copy">
          <span class="eyebrow">VEJA A IDEIA EM PRÁTICA</span><h2 id="demo-heading">{page.imageTitle}<span class="detail-gold-dot">.</span></h2><p>{page.imageDescription}</p>
          <div class="detail-scope"><span class="detail-scope__label">POSSIBILIDADES PARA O PROJETO</span><ul>{page.capabilities.map(cap => <li><span aria-hidden="true">✓</span>{cap}</li>)}</ul></div>
          <p class="detail-disclaimer">Exemplos visuais e informações fictícias. A implementação e disponibilidade de cada funcionalidade dependem de levantamento, viabilidade técnica e proposta.</p>
        </div>
        <div class="detail-demo-visual">
          {page.serviceId === '01' ? (
            <AppStoreDemoPair variant="section" showCaptions={true} />
          ) : (
            <img src={imagePath} width="1200" height="780" loading="lazy" decoding="async" alt={page.imageDescription} />
          )}
        </div>
      </div>
    </section>

    <section class="detail-section detail-section--muted" id="implantacao" aria-labelledby="process-heading">
      <div class="container">
        <div class="detail-heading"><div><span class="eyebrow">NOSSA FORMA DE TRABALHAR</span><h2 id="process-heading">Do entendimento à <span class="highlight">solução ideal.</span></h2></div><p>Definimos prioridades em conjunto e evitamos prometer funcionalidades sem conhecer o contexto da empresa.</p></div>
        <div class="detail-process">
          {page.steps.map((step, i) => <article><span class="detail-process__num">{String(i+1).padStart(2,'0')}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="detail-section detail-faq" aria-labelledby="faq-heading"><div class="container detail-faq__grid">
      <div><span class="eyebrow">PERGUNTAS FREQUENTES</span><h2 id="faq-heading">Uma solução pensada para <span class="highlight">seu cenário.</span></h2><p>Cada empresa tem ferramentas, pessoas e processos próprios. A proposta é construída considerando essas diferenças.</p></div>
      <div class="detail-faq__items">{faq.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
    </div></section>

    <section class="detail-contact" id="contato" aria-labelledby="contact-heading"><div class="container detail-contact__inner"><div><span class="eyebrow">FREQUÊNCIA40 · BRAGANÇA PAULISTA E REGIÃO</span><h2 id="contact-heading">Sua ideia merece um <span class="highlight">projeto bem pensado.</span></h2><p>Converse com a Frequência40 sobre o que seu negócio precisa. Vamos estudar o escopo e encontrar o caminho tecnológico adequado.</p></div><div class="detail-contact__actions"><a class="btn btn--gold" href={proposalUrl}>Solicitar proposta deste serviço <span aria-hidden="true">↗</span></a><a class="btn btn--ghost" href={whatsappUrl(service.name)} target="_blank" rel="noopener noreferrer">Conversar pelo WhatsApp <span aria-hidden="true">↗</span></a></div></div></section>

    <section class="detail-more" aria-label="Conheça outros serviços"><div class="container"><div class="detail-more__head"><div><span class="eyebrow">EXPLORE OUTRAS SOLUÇÕES</span><h2>Seu negócio pode ir <span class="highlight">além.</span></h2></div><a href="/#servicos">Ver todos os 12 serviços ↗</a></div><div class="detail-more__grid">{related.map((item) => { const nextService = services.find(s=>s.id===item.serviceId)!; return <a href={serviceUrl(item.slug)}><span class="detail-more__icon"><ServiceIcon name={nextService.icon} size={26}/></span><span class="detail-more__label">{nextService.name}</span><span class="detail-more__arrow" aria-hidden="true">↗</span></a> })}</div></div></section>
  </main>
  <Footer />
</BaseLayout>
<style>
.detail-hero{position:relative;overflow:hidden;background:radial-gradient(ellipse at 75% 28%,#49332240,transparent 60%),#090a0b;padding:37px 0 82px;border-bottom:1px solid #342b21}
.detail-hero:before{content:'';position:absolute;pointer-events:none;width:650px;height:650px;border-radius:50%;border:1px solid #bf904522;right:-350px;top:-320px}
.detail-breadcrumb{display:flex;gap:11px;align-items:center;flex-wrap:wrap;font-size:.72rem;color:#98938b;margin-bottom:64px}
.detail-breadcrumb a{color:#bbb2a1;text-decoration:none}.detail-breadcrumb a:hover{color:var(--gold-light)}.detail-breadcrumb span:last-child{color:#e5c58f}
.detail-hero__layout{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:clamp(24px,4.4vw,72px);align-items:center}
.detail-overline{display:flex;align-items:center;gap:12px;color:var(--gold-light);font-size:.65rem;font-weight:800;letter-spacing:.12em;line-height:1.45}
.detail-icon{display:grid;place-items:center;width:44px;height:44px;flex:0 0 44px;border:1px solid #755837;background:#3c302021;border-radius:9px}.detail-id{margin-left:auto;color:#76674f;font-size:.75rem}
.detail-hero h1{font-size:clamp(2.75rem,5.5vw,5.1rem);line-height:1.09;letter-spacing:-.065em;margin:26px 0}.detail-lead{font-size:clamp(.97rem,1.25vw,1.13rem);line-height:1.85;color:#bbb8b2;margin-bottom:23px}
.detail-promise{display:flex;gap:14px;align-items:start;font-size:.89rem;line-height:1.65;color:#e0cfb2;margin:0 0 32px}.detail-promise>span{font-size:1.5rem;line-height:1.2;color:var(--gold-light)}
.detail-actions{display:flex;flex-wrap:wrap;gap:12px}.detail-actions .btn{font-size:.75rem;padding-inline:18px}
.detail-hero__art{width:100%;min-width:0;position:relative;overflow:visible}.detail-hero__art>img{width:100%;height:auto;display:block;border-radius:14px;box-shadow:0 35px 85px #0007;border:1px solid #624729}
.detail-hero__art .app-demo-pair{max-width:620px}.detail-art-note{font-size:.57rem;letter-spacing:.13em;color:#907b5a;margin:8px 0 0;text-align:center}
.detail-anchor-nav{background:#131313;border-bottom:1px solid #403322}.detail-anchor-nav__inner{display:flex;gap:30px;overflow-x:auto;scrollbar-width:thin;min-height:57px;align-items:center}.detail-anchor-nav a{font-size:.77rem;white-space:nowrap;text-decoration:none;color:#c5c0b7}.detail-anchor-nav a:hover{color:var(--gold-light)}
.detail-section{padding-block:102px;background:#0b0d0e}.detail-section--muted{background:#121313;border-top:1px solid #25231f;border-bottom:1px solid #25231f}
.detail-heading{display:flex;align-items:end;justify-content:space-between;gap:36px;margin-bottom:41px}.detail-heading h2,.detail-demo-copy h2,.detail-faq h2{font-size:clamp(2.15rem,4.2vw,3.7rem);line-height:1.15;letter-spacing:-.055em;margin:19px 0 0;max-width:730px}.detail-heading>p{font-size:.91rem;line-height:1.78;color:#a8a8a5;max-width:320px;margin:0}
.benefits-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.benefit-card{padding:27px 23px 28px;min-height:230px;border:1px solid #443727;background:linear-gradient(150deg,#171819,#101112)}.benefit-card__num{font-size:.75rem;color:#d7aa69;font-weight:750}.benefit-card h3{margin:36px 0 13px;font-size:1.07rem;line-height:1.3}.benefit-card p{margin:0;color:#a7a5a1;font-size:.81rem;line-height:1.72}
.application-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.application-card{padding:27px;min-height:215px;background:#191a1a;border:1px solid #453829}.application-card__index{display:flex;justify-content:space-between;color:#d7ac6a;font-size:.7rem;font-weight:770}.application-card h3{font-size:1.27rem;line-height:1.28;margin:34px 0 10px}.application-card p{color:#aaa7a1;line-height:1.75;font-size:.86rem;margin:0}
.detail-demo-grid{display:grid;grid-template-columns:minmax(0,.77fr) minmax(0,1.23fr);align-items:center;gap:clamp(30px,5vw,75px)}.detail-demo-copy h2{margin-bottom:24px}.detail-gold-dot{color:#ddad68}.detail-demo-copy>p:not(.detail-disclaimer){color:#b8b6b1;line-height:1.85;font-size:1rem}.detail-demo-visual{min-width:0;background:radial-gradient(ellipse at center,#48351b50,transparent 72%);padding:10px 0}.detail-demo-visual>img{display:block;width:100%;height:auto;border-radius:14px;border:1px solid #5d472c;box-shadow:0 32px 65px #0009}
.detail-scope{border-top:1px solid #53412a;margin-top:28px;padding-top:25px}.detail-scope__label{font-size:.64rem;letter-spacing:.14em;color:var(--gold-light);font-weight:800}.detail-scope ul{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:10px;row-gap:13px;margin:24px 0}.detail-scope li{font-size:.78rem;line-height:1.5;color:#d7d4cd}.detail-scope li span{color:#dcb36c;padding-right:9px}.detail-disclaimer{font-size:.73rem;color:#8e8a83;line-height:1.7}
.detail-process{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.detail-process article{border-top:1px solid #6d5536;padding:24px 14px 0 0}.detail-process__num{font-size:2.6rem;font-weight:800;color:#e2b773;letter-spacing:-.07em}.detail-process h3{font-size:1.15rem;margin:27px 0 12px}.detail-process p{font-size:.88rem;color:#a7a49e;line-height:1.78}
.detail-faq__grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:80px}.detail-faq h2{margin-bottom:20px}.detail-faq__grid>div:first-child>p{color:#aaa;line-height:1.75;font-size:.9rem}.detail-faq__items{border-top:1px solid #56412a}.detail-faq__items details{border-bottom:1px solid #43382b}.detail-faq__items summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:25px 0;font-size:.91rem;font-weight:680;line-height:1.5}.detail-faq__items summary::-webkit-details-marker{display:none}.detail-faq__items summary:after{content:'+';font-size:1.5rem;color:var(--gold-light)}.detail-faq__items details[open] summary:after{content:'−'}.detail-faq__items p{color:#b7b3ac;line-height:1.8;font-size:.85rem;padding:0 18px 19px 0}
.detail-contact{background:radial-gradient(circle at 80% 30%,#8a5c2830,transparent 55%),#15120f;border-block:1px solid #73532a}.detail-contact__inner{display:grid;grid-template-columns:1fr auto;gap:35px;align-items:center;padding-block:80px}.detail-contact h2{font-size:clamp(2.1rem,4vw,3.6rem);line-height:1.15;margin:18px 0;max-width:720px}.detail-contact p{color:#c4b9aa;max-width:590px;line-height:1.7;margin:0}.detail-contact__actions{display:grid;gap:12px;min-width:266px}.detail-contact__actions .btn{font-size:.75rem}
.detail-more{padding-block:82px;background:#0a0b0b}.detail-more__head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:27px}.detail-more h2{font-size:clamp(1.9rem,3vw,2.8rem);margin:14px 0 0}.detail-more__head>a{color:var(--gold-light);text-decoration:none;font-size:.81rem}.detail-more__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.detail-more__grid>a{display:flex;align-items:center;gap:15px;padding:23px 20px;border:1px solid #4c3b26;background:#181918;text-decoration:none;transition:border-color .2s}.detail-more__grid>a:hover{border-color:var(--gold-light)}.detail-more__icon{display:grid;place-items:center;color:var(--gold-light);flex:0 0 42px}.detail-more__label{font-size:.88rem;flex:1;font-weight:690}.detail-more__arrow{color:#d7a45e}
@media(max-width:1050px){.detail-hero__layout{grid-template-columns:1fr 1fr;gap:25px}.detail-hero h1{font-size:clamp(2.6rem,5vw,3.6rem)}.benefits-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-demo-grid{grid-template-columns:1fr;gap:18px}.detail-demo-visual{max-width:850px;width:100%;margin:auto}.detail-faq__grid{gap:34px}}
@media(max-width:760px){.detail-hero{padding:23px 0 62px}.detail-breadcrumb{margin-bottom:42px}.detail-hero__layout{grid-template-columns:1fr;gap:30px}.detail-hero__intro{max-width:700px}.detail-hero h1{font-size:clamp(2.55rem,8.5vw,4.5rem)}.detail-hero__art{max-width:700px;margin:0 auto}.detail-section{padding-block:72px}.detail-heading{display:block}.detail-heading>p{margin-top:18px;max-width:640px}.application-grid{grid-template-columns:1fr 1fr}.detail-contact__inner{grid-template-columns:1fr}.detail-contact__actions{grid-template-columns:1fr 1fr}.detail-faq__grid{grid-template-columns:1fr;gap:25px}.detail-more__grid{grid-template-columns:1fr 1fr}}
@media(max-width:530px){.detail-breadcrumb{font-size:.67rem;gap:7px}.detail-hero h1{font-size:clamp(2.4rem,10.7vw,3.3rem)}.detail-hero__layout{gap:18px}.detail-overline{font-size:.55rem;letter-spacing:.085em}.detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.detail-actions .btn{padding:13px 7px;font-size:.68rem;min-height:48px}.detail-lead{font-size:.94rem}.detail-anchor-nav__inner{gap:24px}.detail-anchor-nav a{font-size:.71rem}.benefits-grid{grid-template-columns:1fr 1fr;gap:8px}.benefit-card{min-height:190px;padding:18px 15px}.benefit-card h3{margin-top:28px;font-size:.92rem}.benefit-card p{font-size:.76rem}.application-grid{grid-template-columns:1fr;gap:10px}.application-card{min-height:0;padding:24px}.application-card h3{margin:24px 0 9px}.detail-heading h2,.detail-demo-copy h2,.detail-faq h2{font-size:clamp(2rem,9vw,2.7rem)}.detail-scope ul{grid-template-columns:1fr 1fr;gap:12px}.detail-process{grid-template-columns:1fr;gap:24px}.detail-process h3{margin:13px 0}.detail-contact__inner{padding-block:65px}.detail-contact__actions{grid-template-columns:1fr}.detail-more__head{display:block}.detail-more__head>a{display:block;margin-top:17px}.detail-more__grid{grid-template-columns:1fr}}
</style>
