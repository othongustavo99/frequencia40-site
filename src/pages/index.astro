---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import ExperienceShowcase from '../components/ExperienceShowcase.astro';
import AppStoreDemoPair from '../components/AppStoreDemoPair.astro';
import { company, services, whatsappUrl } from '../data/site';
import { serviceUrlById } from '../data/service-pages';
---
<BaseLayout title="Frequência40 | Desenvolvimento e Tecnologia — Programando o Futuro" structuredData={true}>
  <Header />
  <main id="principal">
    <!-- HERO -->
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <span class="hero__arc hero__arc--one" aria-hidden="true"></span>
      <span class="hero__arc hero__arc--two" aria-hidden="true"></span>
      <div class="hero__grain" aria-hidden="true"></div>
      <div class="container hero__grid">
        <div class="hero__content" data-reveal>
          <span class="eyebrow hero__eyebrow">DESENVOLVIMENTO E TECNOLOGIA</span>
          <h1 id="hero-title">Seu negócio merece uma tecnologia à <span class="highlight">altura do futuro.</span></h1>
          <p class="hero__description">Aplicativos, sistemas, integrações e soluções digitais feitas para simplificar o presente e acelerar o que vem pela frente.</p>
          <div class="hero__actions">
            <a class="btn btn--gold" href="#servicos">Conheça nossas soluções <span aria-hidden="true">↗</span></a>
            <a class="btn btn--ghost" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Fale com a Frequência40 <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero__location"><span class="status-dot" aria-hidden="true"></span> Atendendo Bragança Paulista e região</div>
        </div>
        <div class="hero__scene" data-reveal aria-label="Apresentação visual com duas telas demonstrativas do catálogo digital e do painel administrativo">
          <div class="hero__orbit hero__orbit--outer" aria-hidden="true"></div>
          <div class="hero__orbit hero__orbit--inner" aria-hidden="true"></div>
          <AppStoreDemoPair variant="hero" showBadge={true} showCaptions={false} />
        </div>
      </div>
      <div class="hero__scroll" aria-hidden="true">EXPLORE <span></span></div>
    </section>

    <!-- VALORES -->
    <section class="values" aria-label="Nossa forma de trabalhar"><div class="container values__grid">
      <div><span class="values__icon">01 /</span><strong>Soluções sob medida</strong><p>Cada negócio tem um caminho. A tecnologia acompanha o seu.</p></div>
      <div><span class="values__icon">02 /</span><strong>Conexão com o comércio local</strong><p>Proximidade para entender desafios de verdade.</p></div>
      <div><span class="values__icon">03 /</span><strong>Do planejamento à entrega</strong><p>Desenvolvimento, integração e suporte de ponta a ponta.</p></div>
    </div></section>

    <!-- SERVIÇOS -->
    <section class="section services" id="servicos" aria-labelledby="services-title">
      <div class="container">
        <div class="section-top"><div><span class="eyebrow">O QUE FAZEMOS</span><h2 class="section-title" id="services-title">Um universo de soluções.<br/><span class="highlight">Uma parceira de tecnologia.</span></h2></div><p class="section-lead">Da primeira presença digital aos sistemas que movem a operação. Escolha o que seu negócio precisa — ou conte uma ideia para construirmos juntos.</p></div>
        <a class="services__explore" href="/solucoes/">Conheça nossas demonstrações de soluções <span aria-hidden="true">↗</span></a>
        <div class="services__grid">
          {services.map((service) => <a class="service-card" href={serviceUrlById(service.id)} aria-label={`Conhecer solução: ${service.name}`} data-reveal>
            <div class="service-card__top"><span class="service-card__icon"><ServiceIcon name={service.icon} size={27}/></span><span class="service-card__number">/{service.id}</span></div>
            <h3>{service.name}</h3><p>{service.summary}</p>
            <span class="service-card__link">Conhecer solução <span aria-hidden="true">↗</span></span>
          </a>)}
        </div>
        <div class="services__custom"><span class="services__custom-star" aria-hidden="true">✳</span><p>Não encontrou exatamente o que precisa? <strong>Nós desenvolvemos a solução junto com você.</strong></p><a class="link-inline" href={whatsappUrl('uma solução tecnológica personalizada')} target="_blank" rel="noopener noreferrer">Conte sua ideia <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <!-- INSPIRAÇÕES VISUAIS PARA O COMÉRCIO -->
    <ExperienceShowcase />

    <!-- PRODUTO EM DESTAQUE -->
    <section class="showcase section" id="catalogo" aria-labelledby="catalog-title">
      <div class="container showcase__grid">
        <div class="showcase__visual" data-reveal>
          <div class="showcase__frame showcase__frame--screenshots">
            <div class="showcase__frame-top"><span>F40 <strong>CATÁLOGO</strong></span><span>VITRINE + ADMINISTRAÇÃO</span></div>
            <AppStoreDemoPair variant="section" showCaptions={true} />
          </div>
        </div>
        <div class="showcase__copy" data-reveal><span class="eyebrow">NOSSA SOLUÇÃO EM DESTAQUE</span><span class="showcase__tag">PROJETO EM FINALIZAÇÃO</span><h2 class="section-title" id="catalog-title">A vitrine do seu negócio. <span class="highlight">Agora, em todo lugar.</span></h2><p class="showcase__intro">Estamos finalizando nossa solução de catálogo digital: uma experiência moderna para apresentar produtos, facilitar pedidos e aproximar sua loja de novos clientes.</p>
          <div class="showcase__features"><div><span>↗</span> Vitrine organizada de produtos</div><div><span>↗</span> Acesso pelo celular e computador</div><div><span>↗</span> Integração com atendimento e pedidos</div><div><span>↗</span> Personalização para a sua marca</div></div>
          <a class="btn btn--gold" href={whatsappUrl('catálogo digital para minha loja')} target="_blank" rel="noopener noreferrer">Quero um catálogo para minha loja <span aria-hidden="true">↗</span></a><p class="showcase__disclaimer">As telas ilustram o aplicativo em desenvolvimento. Produtos, preços e indicadores exibidos são demonstrativos e fictícios. Funcionalidades e disponibilidade dependem do projeto contratado.</p>
        </div>
      </div>
    </section>

    <!-- SOBRE E PROCESSO -->
    <section class="section about" id="sobre" aria-labelledby="about-title"><div class="container about__grid"><div><span class="eyebrow">SOBRE A FREQUÊNCIA40</span><h2 class="section-title" id="about-title">Ideias ambiciosas merecem <span class="highlight">boas soluções.</span></h2></div><div class="about__text"><p>A Frequência40 nasce da vontade de colocar a tecnologia a serviço de quem empreende. Nosso foco é entender o desafio de cada empresa e criar soluções digitais que façam sentido no dia a dia.</p><p>Atuamos com desenvolvimento de aplicativos, sistemas, integrações, automações e suporte tecnológico. Quando a necessidade é única, o caminho também pode ser.</p><a class="link-inline" href={whatsappUrl('uma conversa sobre meu negócio')} target="_blank" rel="noopener noreferrer">Vamos conversar sobre seu projeto <span aria-hidden="true">↗</span></a></div></div>
      <div class="container process"><h3>Do primeiro contato à solução ideal.</h3><div class="process__grid"><div><span>01</span><strong>Entendemos</strong><p>Ouvimos a sua ideia, sua operação e o problema que você quer resolver.</p></div><div><span>02</span><strong>Planejamos</strong><p>Definimos uma proposta viável, com escopo e etapas claras.</p></div><div><span>03</span><strong>Desenvolvemos</strong><p>Construímos, integramos e acompanhamos a entrega da solução.</p></div></div></div>
    </section>

    <!-- CTA FINAL -->
    <section class="closing" id="contato" aria-labelledby="closing-title"><div class="container closing__inner"><div class="closing__halo" aria-hidden="true"></div><span class="eyebrow">SEU PRÓXIMO PASSO</span><h2 id="closing-title">Sua ideia pode ser o<br/><span class="highlight">nosso próximo projeto.</span></h2><p>Vamos conversar sobre o que a tecnologia pode fazer pelo seu negócio.</p><a class="btn btn--gold" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Solicitar orçamento no WhatsApp <span aria-hidden="true">↗</span></a><span class="closing__area">BRAGANÇA PAULISTA E REGIÃO</span></div></section>
  </main>
  <Footer />
</BaseLayout>
<style>
.hero{position:relative;overflow:hidden;isolation:isolate;background:radial-gradient(ellipse at 74% 37%,#2c23164e 0%,transparent 42%),linear-gradient(120deg,#0a0a0b 42%,#0b0c0d)}
.hero__grid{min-height:690px;display:grid;grid-template-columns:1.03fr .97fr;align-items:center;gap:20px;padding-block:93px 108px}
.hero__content{position:relative;z-index:3}.hero__eyebrow{font-size:.65rem}
.hero h1{font-size:clamp(3.05rem,5.65vw,5.15rem);line-height:1.09;margin:27px 0 23px;max-width:660px;font-weight:760}
.hero__description{color:#b7b7b5;line-height:1.86;font-size:1rem;max-width:530px}
.hero__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.hero__location{display:flex;align-items:center;gap:10px;color:#aaa7a0;font-size:.75rem;letter-spacing:.035em;margin-top:49px}
.status-dot{width:8px;height:8px;border-radius:50%;background:#d8a751;box-shadow:0 0 0 4px #d8a75121}
.hero__arc{position:absolute;border:1px solid rgba(216,168,83,.37);border-radius:50%;pointer-events:none;z-index:-1}
.hero__arc--one{width:430px;height:430px;left:-317px;top:-254px}.hero__arc--two{width:640px;height:640px;right:-448px;bottom:-403px}
.hero__grain{pointer-events:none;position:absolute;inset:0;background-image:radial-gradient(#f6db9813 .6px,transparent .6px);background-size:7px 7px;opacity:.22}
.hero__scene{height:465px;min-width:0;position:relative;display:flex;align-items:center;justify-content:center;perspective:1000px}
.hero__orbit{position:absolute;border:1px solid #b9914c35;border-radius:50%;pointer-events:none}.hero__orbit--outer{width:525px;height:525px;transform:rotate(-18deg) scaleX(.93)}.hero__orbit--inner{width:388px;height:388px;border-color:#eac17b22}
.display-card{position:relative;width:min(100%,475px);background:#f6f4ee;border-radius:13px;border:7px solid #202022;box-shadow:0 28px 80px #000c,0 0 65px #c69b4a16,0 0 0 1px #b894572b;transform:rotateY(-8deg) rotateX(3deg) rotateZ(1deg);animation:gentleFloat 8s ease-in-out infinite}
.display-card__top{height:32px;background:#e6e2dc;border-radius:5px 5px 0 0;display:flex;align-items:center;gap:5px;padding-inline:12px}.display-card__dot{width:6px;height:6px;border-radius:50%;background:#c9c5bf}.display-card__url{margin-inline:auto;font-size:8px;letter-spacing:.1em;color:#8d877d;text-transform:uppercase}
.display-card__body{padding:15px;color:#272221}.display-card__nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:13px}.display-card__logo{font-size:18px;font-weight:760;letter-spacing:-.07em}.display-card__logo span{color:#9f7950}.display-card__navlinks{font-size:7.4px;letter-spacing:.04em;color:#79736c}
.display-card__banner{height:127px;background:linear-gradient(128deg,#352920,#8d6d50 56%,#d3b591);padding:24px;display:flex;flex-direction:column;justify-content:center;color:#fff;position:relative;overflow:hidden}.display-card__banner:after{content:'';position:absolute;border-radius:100px;border:18px solid #ffffff14;width:200px;height:200px;right:-65px;top:-50px}.display-card__bannerlabel{font-size:8px;letter-spacing:.24em;margin-bottom:10px;opacity:.8}.display-card__banner strong{font-size:23px;font-weight:600;letter-spacing:-.05em}.display-card__bannerline{height:1px;width:53px;margin-top:12px;background:#f0d0a1}
.display-card__products{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:13px}.display-card__product{display:flex;flex-direction:column;gap:3px}.display-card__product img{display:block;width:100%;height:auto;aspect-ratio:1.04;object-fit:cover}.display-card__product span{font-size:8.5px;font-weight:750}.display-card__product small{font-size:8px;color:#987348}
.scene-badge{position:absolute;right:-13px;bottom:15px;display:flex;gap:12px;align-items:center;background:#131313;border:1px solid #675233;padding:13px 19px;border-radius:5px;box-shadow:0 16px 35px #0009;color:#aaa;font-size:.66rem;transform:rotate(-3deg);z-index:2}.scene-badge__icon{font-size:1.35rem;color:var(--gold-light)}.scene-badge strong{display:block;color:#f2eee8;font-size:.8rem;margin-top:3px}.hero__visualnote{position:absolute;bottom:-34px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:.57rem;letter-spacing:.16em;color:#898279}
.hero__scroll{position:absolute;bottom:35px;left:max(24px,calc((100vw - 1180px)/2));font-size:.63rem;letter-spacing:.2em;color:#807667;display:flex;align-items:center;gap:12px}.hero__scroll span{display:block;width:34px;height:1px;background:var(--gold)}
@keyframes gentleFloat{50%{transform:rotateY(-8deg) rotateX(3deg) rotateZ(1deg) translateY(-10px)}}
.values{background:#111213;border-top:1px solid #3c3020;border-bottom:1px solid #292520}.values__grid{display:grid;grid-template-columns:repeat(3,1fr)}.values__grid>div{padding:33px 30px 31px;border-right:1px solid #3b3024}.values__grid>div:first-child{padding-left:0}.values__grid>div:last-child{border:0}.values__icon{display:block;font-size:.7rem;letter-spacing:.08em;font-weight:800;color:var(--gold-light);margin-bottom:11px}.values strong{font-size:.91rem}.values p{font-size:.77rem;color:#999;margin:8px 0 0;line-height:1.6}
.services{background:radial-gradient(circle at 0 20%,#261d151b,transparent 32%),#0c0d0e}.services__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.service-card{color:var(--white);text-decoration:none;min-height:275px;padding:27px 26px 24px;background:linear-gradient(140deg,#171819,#111213);border:1px solid #3a3024;display:flex;flex-direction:column;transition:transform .25s,border-color .25s,background .25s}.service-card:hover{transform:translateY(-4px);border-color:#947342;background:#191817}.service-card__top{display:flex;justify-content:space-between;align-items:start}.service-card__icon{width:52px;height:52px;display:grid;place-items:center;border-radius:5px;color:var(--gold-light);background:#3c302023;border:1px solid #70573566}.service-card__number{font-size:.65rem;letter-spacing:.12em;color:#746957}.service-card h3{font-size:1.09rem;font-weight:680;line-height:1.4;letter-spacing:-.035em;margin:20px 0 9px}.service-card p{font-size:.79rem;line-height:1.7;color:#a5a5a2;margin:0 0 16px}.service-card__link{margin-top:auto;font-size:.75rem;color:var(--gold-light);text-decoration:none;font-weight:670;display:flex;gap:10px;align-items:center}.service-card:hover .service-card__link{text-decoration:underline}.services__custom{display:flex;align-items:center;gap:20px;margin-top:22px;border:1px solid #604a2c;background:#251e14aa;padding:22px 29px}.services__custom-star{font-size:24px;color:var(--gold)}.services__custom p{flex:1;margin:0;font-size:.84rem;color:#bdb7ad;line-height:1.7}.services__custom p strong{color:#f3ede4;font-weight:650}.services__custom a{white-space:nowrap}
.showcase{background:#111112;border-block:1px solid #352c20}.showcase__grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(35px,7vw,105px);align-items:center}.showcase__visual{min-width:0}.showcase__frame{min-height:560px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(circle at 52% 47%,#5b4830 0%,#2a2219 37%,#111210 70%);border:1px solid #6c5331}.showcase__frame:before,.showcase__frame:after{content:'';position:absolute;width:410px;height:410px;border:1px solid #bb8d4f6b;border-radius:50%}.showcase__frame:after{width:530px;height:530px;border-color:#bf94512a}.showcase__frame-top{position:absolute;left:23px;right:23px;top:24px;display:flex;justify-content:space-between;align-items:center;z-index:4;color:var(--gold-light);font-size:.7rem;letter-spacing:.16em}.showcase__frame-top span:last-child{font-size:.55rem;letter-spacing:.12em;color:#aea08b}.showcase__frame-top strong{font-weight:450;color:#fff}
/* Duas telas reais fornecidas para apresentação do projeto em destaque. */
.showcase__frame--screenshots{min-height:590px;padding:72px 22px 48px;background:radial-gradient(ellipse at 50% 40%,#5a4326 0%,#28221b 39%,#101112 77%)}
.showcase__frame--screenshots:before,.showcase__frame--screenshots:after{pointer-events:none}
.showcase__screens{position:relative;z-index:2;width:min(100%,505px);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;justify-items:center;gap:15px}
.showcase__screen{display:flex;flex-direction:column;align-items:center;min-width:0;width:100%;max-width:231px;color:#f5f1e8;text-decoration:none;outline-offset:5px;transition:transform .25s ease}
.showcase__screen:nth-child(2){margin-top:20px}
.showcase__screen-device{display:block;min-width:0;width:100%;padding:6px;border-radius:26px;background:linear-gradient(145deg,#4b443b 0%,#181818 22%,#080809 80%,#957248 100%);box-shadow:0 20px 32px #000a,0 0 0 1px #f2c78452}
.showcase__screen-device img{display:block;width:100%;height:auto;aspect-ratio:auto;max-height:none;border-radius:20px;object-fit:contain;background:#fbf9f6}
.showcase__screen-caption{display:grid;gap:5px;align-self:stretch;padding:14px 0 0;text-align:center;line-height:1.3}
.showcase__screen-caption strong{font-size:.77rem;font-weight:710}
.showcase__screen-caption>span{font-size:.64rem;color:#e1c38b}
.showcase__screen-caption>span span{padding-left:3px}
.showcase__frame-note{position:absolute;left:12px;right:12px;bottom:16px;text-align:center;z-index:3;color:#c3ad87;font-size:.54rem;letter-spacing:.13em}
@media(hover:hover) and (prefers-reduced-motion:no-preference){.showcase__screen:hover{transform:translateY(-6px)}.showcase__screen:hover .showcase__screen-device{box-shadow:0 25px 38px #000b,0 0 0 1px #f0c47799}}
.showcase__copy{padding-block:16px}.showcase__tag{display:inline-block;border:1px solid #6d5836;border-radius:3px;color:#d9c29b;font-size:.57rem;padding:7px 10px;letter-spacing:.12em;margin:18px 0 0}.showcase .section-title{font-size:clamp(2.1rem,3.8vw,3.4rem);margin:21px 0 20px}.showcase__intro{font-size:.94rem;color:var(--muted);line-height:1.84;max-width:550px}.showcase__features{margin:27px 0 31px;display:grid;gap:14px}.showcase__features div{font-size:.86rem;color:#d5d0c6}.showcase__features span{color:var(--gold-light);margin-right:12px}.showcase__disclaimer{font-size:.68rem;line-height:1.5;color:#807c77;margin:18px 0 0}
.about{background:radial-gradient(circle at 80% 17%,#6e502d13,transparent 25%),#0d0e0e}.about__grid{display:grid;grid-template-columns:1fr 1fr;gap:90px}.about__text{padding-top:19px}.about__text p{font-size:.95rem;line-height:1.94;color:var(--muted);margin-bottom:18px}.about__text a{margin-top:14px}.process{margin-top:78px;border-top:1px solid #463723;padding-top:39px}.process h3{font-size:1.2rem;letter-spacing:-.03em;margin-bottom:26px}.process__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.process__grid>div{padding:23px 23px 18px;background:#141515;border:1px solid #383027}.process__grid span{font-size:.72rem;color:var(--gold-light);display:block;margin-bottom:22px}.process__grid strong{font-size:1.06rem}.process__grid p{color:#a1a19e;font-size:.81rem;line-height:1.7;margin:12px 0 0}
.closing{background:#0c0b0a;overflow:hidden}.closing__inner{position:relative;text-align:center;isolation:isolate;padding-block:120px 122px}.closing__halo{position:absolute;left:50%;top:0;transform:translateX(-50%);width:640px;height:640px;border:1px solid #cba15b2c;border-radius:50%;z-index:-1;box-shadow:0 0 0 115px #ba8e3411,0 0 0 228px #d3a45b08}.closing__inner .eyebrow:before{display:none}.closing h2{font-size:clamp(2.7rem,5.5vw,4.8rem);line-height:1.13;margin:23px 0 18px}.closing p{font-size:.98rem;color:#b6b2a9;margin-bottom:29px}.closing__area{display:block;color:#87775e;font-size:.62rem;letter-spacing:.23em;margin-top:44px}
@media(max-width:1100px){.hero__grid{grid-template-columns:1fr .9fr}.hero h1{font-size:clamp(2.8rem,5vw,4.4rem)}.hero__scene{transform:scale(.92);transform-origin:center}.scene-badge{right:-18px}.service-card{min-height:290px}.showcase__grid{gap:43px}}
