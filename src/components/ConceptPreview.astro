---
interface Props {
  kind: 'catalogo' | 'gestao' | 'atendimento' | 'agenda';
}
const { kind } = Astro.props;
---
<div class:list={['concept', `concept--${kind}`]} role="img" aria-label={
  kind === 'catalogo' ? 'Exemplo ilustrativo de loja virtual com coleções e produtos fictícios' :
  kind === 'gestao' ? 'Exemplo ilustrativo de painel gerencial com vendas e produtos fictícios' :
  kind === 'atendimento' ? 'Exemplo ilustrativo de fluxo automático entre cliente, atendimento e estoque' :
  'Exemplo ilustrativo de sistema para agendamentos com calendário e horários fictícios'
}>
  {kind === 'catalogo' && (
    <div class="catalog-shell" aria-hidden="true">
      <div class="catalog-desktop">
        <div class="chrome"><span class="traffic"><i></i><i></i><i></i></span><span>atelier.exemplo</span><span>↗</span></div>
        <div class="shop-head"><strong>atelier<span>.</span></strong><span>Novidades&nbsp;&nbsp;&nbsp; Coleções&nbsp;&nbsp;&nbsp; Sobre</span><b>♡ &nbsp; ▢</b></div>
        <div class="shop-banner"><div><small>EDIÇÃO ESSENCIAL / 2026</small><strong>Design para<br/>o dia a dia.</strong><span>Explorar coleção ↗</span></div><div class="banner-object"><span></span><span></span></div></div>
        <div class="shop-heading"><strong>Escolhas da semana</strong><span>Ver coleção completa →</span></div>
        <div class="shop-products">
          <div><img src="/images/product-bag.svg" width="175" height="175" loading="lazy" alt=""/><b>Bolsa Urbana</b><span>R$ 149,90</span></div>
          <div><img src="/images/product-shoe.svg" width="175" height="175" loading="lazy" alt=""/><b>Tênis Essential</b><span>R$ 229,90</span></div>
          <div><img src="/images/product-watch.svg" width="175" height="175" loading="lazy" alt=""/><b>Relógio Classic</b><span>R$ 189,90</span></div>
        </div>
      </div>
      <div class="phone-shell"><div class="phone-status"><span>9:41</span><span>●●●</span></div><div class="phone-title">atelier<span>.</span><b>☰</b></div><div class="phone-banner">NOVA COLEÇÃO<strong>Essenciais<br/>modernos.</strong></div><div class="phone-caption">Para você <span>Ver tudo →</span></div><div class="phone-items"><img src="/images/product-bag.svg" width="140" height="140" loading="lazy" alt=""/><img src="/images/product-shoe.svg" width="140" height="140" loading="lazy" alt=""/></div><div class="phone-bottom">⌂ &nbsp; Categorias &nbsp; ♡ &nbsp; ▢</div></div>
      <span class="concept-footnote">Demonstração visual / marca e produtos fictícios</span>
    </div>
  )}
  {kind === 'gestao' && (
    <div class="dashboard-shell" aria-hidden="true">
      <div class="dash-sidebar"><strong><span>F</span> Painel</strong><div class="side-selected">◫ <span>Visão geral</span></div><div>▤ <span>Pedidos</span></div><div>▦ <span>Estoque</span></div><div>◷ <span>Relatórios</span></div><div>⚙ <span>Configurações</span></div><small>EXEMPLO VISUAL</small></div>
      <div class="dash-main"><div class="dash-header"><div><small>PAINEL DEMONSTRATIVO</small><h3>Visão geral</h3></div><span>Últimos 30 dias ⌄</span></div>
        <div class="dash-kpis"><div><span>Vendas do período</span><strong>R$ 24.580</strong><small>↗ Exemplo fictício</small></div><div><span>Pedidos</span><strong>168</strong><small>Últimos 30 dias</small></div><div><span>Produtos ativos</span><strong>342</strong><small>Catálogo conectado</small></div></div>
        <div class="dash-graphs"><div class="dash-graph"><div class="dash-widget-head">Evolução das vendas <span>Mensal</span></div><svg viewBox="0 0 470 175" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="dash-fill" x1="0" x2="0" y1="0" y2="1"><stop stop-color="#d2a65e" stop-opacity=".2"/><stop offset="1" stop-color="#d2a65e" stop-opacity="0"/></linearGradient></defs><path d="M0 35H470 M0 77H470 M0 119H470 M0 160H470" stroke="#303233" stroke-width="1" fill="none"/><path d="M0 145L45 124L92 128L135 90L178 110L226 83L274 90L318 56L364 69L411 33L470 43V175H0Z" fill="url(#dash-fill)"/><path d="M0 145L45 124L92 128L135 90L178 110L226 83L274 90L318 56L364 69L411 33L470 43" stroke="#e0b66c" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><div class="axis"><span>SEM 01</span><span>SEM 02</span><span>SEM 03</span><span>SEM 04</span></div></div><div class="dash-ranking"><div class="dash-widget-head">Mais vendidos</div><div><span>01</span><strong>Bolsa Urbana</strong><b>42</b></div><div><span>02</span><strong>Tênis Essential</strong><b>36</b></div><div><span>03</span><strong>Relógio Classic</strong><b>24</b></div></div></div>
        <div class="dash-table"><div class="dash-widget-head">Pedidos recentes <span>Visualizar todos ↗</span></div><div><span>#PED-1042</span><span>Pagamento confirmado</span><b>R$ 229,90</b></div><div><span>#PED-1041</span><span>Em separação</span><b>R$ 149,90</b></div></div>
      </div><span class="concept-footnote">Dados fictícios / painel demonstrativo, não conectado a operações reais</span>
    </div>
  )}
  {kind === 'atendimento' && (
    <div class="automation-shell" aria-hidden="true"><div class="auto-flow"><div class="flow-label">FLUXO CONCEITUAL</div><div class="flow-node"><span>01</span><div><strong>Cliente inicia a conversa</strong><small>Pergunta sobre produtos disponíveis</small></div></div><div class="flow-line"></div><div class="flow-node"><span>02</span><div><strong>Consulta ao catálogo</strong><small>Integração com produtos e estoque</small></div></div><div class="flow-line"></div><div class="flow-node"><span>03</span><div><strong>Resposta ou atendimento humano</strong><small>Conforme a necessidade do cliente</small></div></div><div class="flow-mini"><span>Catálogo</span><span>Estoque</span><span>Atendimento</span></div></div>
      <div class="chat-mock"><div class="chat-head"><span class="chat-avatar">A</span><div><strong>Atendimento</strong><small>Simulação · Loja Exemplo</small></div><span class="chat-head-more">⋯</span></div><div class="chat-body"><span class="chat-day">HOJE</span><div class="bubble bubble--customer">Olá! Vocês têm a Bolsa Urbana disponível?</div><div class="bubble bubble--brand">Olá! 😊 Vou consultar as informações do catálogo para te ajudar.</div><div class="bubble bubble--brand">A Bolsa Urbana aparece no nosso catálogo de exemplo por <strong>R$ 149,90.</strong> Quer falar com um atendente?</div><div class="bubble bubble--customer">Sim, por favor!</div></div><div class="chat-input">Escreva uma mensagem... <span>➤</span></div></div><span class="concept-footnote">Conversa inteiramente fictícia / não é um atendimento em funcionamento</span></div>
  )}
  {kind === 'agenda' && (
    <div class="schedule-shell" aria-hidden="true"><div class="schedule-top"><div><span>AGENDA / DEMONSTRAÇÃO</span><h3>Seus horários, organizados.</h3></div><span class="schedule-month">Outubro 2026 ▾</span></div><div class="schedule-grid"><div class="calendar"><div class="days"><b>SEG</b><b>TER</b><b>QUA</b><b>QUI</b><b>SEX</b><b>SÁB</b><b>DOM</b></div><div class="dates"><span class="dim">28</span><span class="dim">29</span><span class="dim">30</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span>12</span><span>13</span><span>14</span><span>15</span><span>16</span><span>17</span><span>18</span><span>19</span><span>20</span><span class="selected">21</span><span>22</span><span>23</span><span>24</span><span>25</span><span>26</span><span>27</span><span>28</span><span>29</span><span>30</span><span>31</span><span class="dim">1</span></div></div><div class="slots"><strong>21 de outubro</strong><p>Horários ilustrativos</p><div><span>09:00</span><b>Disponível</b></div><div><span>10:30</span><b class="taken">Reservado</b></div><div><span>14:00</span><b>Disponível</b></div><div><span>16:15</span><b>Disponível</b></div></div></div><div class="schedule-bottom"><span>Confirmação de horário</span><span>Agenda por profissional</span><span>Lembretes automatizados</span></div><span class="concept-footnote">Datas e disponibilidade simuladas / sistema ilustrativo</span></div>
  )}
</div>
<style>
.concept{position:relative;min-width:0;overflow:hidden;isolation:isolate;background:radial-gradient(circle at 55% 35%,#3c2c19 0%,#121212 65%,#090a0a 100%);border:1px solid #4a3924;border-radius:15px;min-height:455px;color:#ecebe8;font-family:Inter,"Segoe UI",Arial,sans-serif}
.concept-footnote{position:absolute;z-index:5;left:15px;bottom:10px;font-size:9px!important;color:#bdad94!important;letter-spacing:.015em!important;text-shadow:0 1px 4px #000!important}
/* storefront: one realistic desktop + phone preview, fully local */
.catalog-shell{height:100%;min-height:455px;position:relative;padding:41px 45px 37px}
.catalog-desktop{width:80%;background:#faf7f1;border-radius:10px;box-shadow:0 30px 70px #000a;color:#1f2020;overflow:hidden;transform:rotate(-2deg);border:5px solid #242427}
.chrome{height:25px;background:#eae6df;display:flex;align-items:center;justify-content:space-between;padding:0 11px;color:#827d71;font-size:8px}.traffic{display:flex;gap:3px}.traffic i{height:6px;width:6px;background:#c0bab2;border-radius:100%}.shop-head{height:53px;display:flex;align-items:center;justify-content:space-between;padding:0 23px;font-size:9px}.shop-head strong{font-size:23px;letter-spacing:-.08em}.shop-head strong span,.phone-title span{color:#ac7953}.shop-head>b{font-size:15px}
.shop-banner{height:135px;background:linear-gradient(120deg,#342f29 0%,#85664b 62%,#c4a27b);display:flex;align-items:center;justify-content:space-between;overflow:hidden;color:#fff;padding:20px 35px}.shop-banner>div:first-child{display:flex;flex-direction:column;gap:7px}.shop-banner small{font-size:7px;letter-spacing:.18em}.shop-banner strong{font-size:27px;line-height:1.1;letter-spacing:-.055em}.shop-banner span{font-size:8px}.banner-object{position:relative;width:130px;height:110px;border:17px solid #fffae51c;border-radius:50%;transform:rotate(18deg);box-shadow:0 0 0 22px #e7d2b017}
.shop-heading{padding:18px 23px 11px;display:flex;justify-content:space-between;align-items:center;font-size:13px}.shop-heading span{font-size:8px;color:#82634c}.shop-products{padding:0 20px 19px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.shop-products div{display:flex;flex-direction:column;gap:3px;font-size:9px}.shop-products img{width:100%;max-height:125px;object-fit:cover;border-radius:2px}.shop-products span{font-size:8px;color:#86633f}
.phone-shell{position:absolute;right:24px;top:93px;width:153px;height:304px;padding:7px;border-radius:28px;border:6px solid #141517;box-shadow:0 21px 55px #000d,0 0 0 1px #d2b07678;background:#fbf8f1;color:#27211d;transform:rotate(6deg)}.phone-status{height:18px;display:flex;justify-content:space-between;padding:0 8px;font-size:8px}.phone-title{display:flex;justify-content:space-between;padding:8px 7px;font-size:17px;font-weight:800}.phone-title b{font-size:11px}.phone-banner{height:80px;padding:12px;background:linear-gradient(130deg,#4c382d,#aa8962);color:#fff;font-size:7px;letter-spacing:.12em}.phone-banner strong{display:block;font-size:16px;letter-spacing:-.06em;line-height:1.1;margin-top:8px}.phone-caption{display:flex;justify-content:space-between;padding:12px 5px 6px;font-size:9px;font-weight:750}.phone-caption span{font-size:6px;color:#947857}.phone-items{display:flex;gap:5px}.phone-items img{width:50%;height:77px;object-fit:cover}.phone-bottom{position:absolute;bottom:10px;left:10px;right:10px;text-align:center;border-top:1px solid #ddd5c9;padding-top:8px;font-size:7px;color:#877464}
/* management dashboard */
.dashboard-shell{min-height:455px;display:grid;grid-template-columns:145px 1fr;background:#111314;color:#e9e9e7;padding-bottom:30px}.dash-sidebar{background:#17191a;padding:23px 14px 20px;border-right:1px solid #33312a;display:flex;flex-direction:column;gap:8px}.dash-sidebar strong{font-size:14px;margin-bottom:34px;letter-spacing:-.03em}.dash-sidebar strong span{display:inline-grid;place-items:center;background:#d0a55c;color:#16110d;width:23px;height:23px;border-radius:5px}.dash-sidebar>div{display:flex;align-items:center;gap:8px;color:#929493;font-size:10px;padding:11px 7px;border-radius:5px}.dash-sidebar>div.side-selected{background:#d5a95b1c;color:#f0c777}.dash-sidebar small{font-size:8px;color:#716552;letter-spacing:.15em;margin-top:auto}.dash-main{padding:24px 26px;min-width:0}.dash-header{display:flex;justify-content:space-between;align-items:center}.dash-header small{color:#b3915b;font-size:9px;letter-spacing:.12em}.dash-header h3{font-size:22px;margin:5px 0 19px;letter-spacing:-.04em}.dash-header>span{border:1px solid #3c3d3d;padding:8px;border-radius:5px;font-size:10px;color:#a9aaa9}.dash-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.dash-kpis>div{background:#1b1d1f;border:1px solid #373531;border-radius:8px;padding:13px}.dash-kpis span{display:block;color:#a9a6a0;font-size:10px}.dash-kpis strong{display:block;font-size:22px;letter-spacing:-.05em;margin:10px 0 7px}.dash-kpis small{color:#cba864;font-size:9px}.dash-graphs{display:grid;grid-template-columns:1.6fr 1fr;gap:9px;margin-top:10px}.dash-graph,.dash-ranking,.dash-table{background:#1b1d1f;border:1px solid #373531;border-radius:8px;padding:13px;min-width:0}.dash-widget-head{display:flex;justify-content:space-between;gap:8px;font-size:11px;font-weight:700}.dash-widget-head span{font-size:9px;color:#999}.dash-graph svg{display:block;width:100%;height:113px;margin-top:10px}.axis{display:flex;justify-content:space-between;font-size:8px;color:#7b7c7c}.dash-ranking>div:not(.dash-widget-head){display:flex;align-items:center;gap:9px;padding:13px 0 0;font-size:10px}.dash-ranking span{color:#bd9755}.dash-ranking strong{font-weight:500;flex:1}.dash-ranking b{color:#e7bd72}.dash-table{margin-top:9px}.dash-table>div:not(.dash-widget-head){display:flex;justify-content:space-between;gap:7px;border-top:1px solid #373531;padding-top:10px;margin-top:10px;font-size:10px}.dash-table span:nth-child(2){color:#b5ad9b}.dash-table b{font-weight:600}
/* automation */
.automation-shell{min-height:455px;display:grid;grid-template-columns:44% 56%;padding:33px 37px 36px;gap:22px;align-items:center}.auto-flow{padding:0 5px}.flow-label{font-size:9px;letter-spacing:.2em;color:#dcb36d;margin-bottom:24px}.flow-node{display:flex;align-items:center;gap:13px;background:#202020;border:1px solid #51402b;border-radius:9px;padding:13px 12px}.flow-node>span{display:grid;place-items:center;border-radius:6px;background:#b88f4f1e;color:#e4bc76;border:1px solid #806038;width:32px;height:32px;font-size:12px;flex:none}.flow-node strong{display:block;font-size:12px}.flow-node small{display:block;font-size:9px;color:#aaa5a0;margin-top:4px}.flow-line{height:18px;width:1px;background:#9f814d;margin-left:28px}.flow-mini{display:flex;gap:7px;margin-top:17px;flex-wrap:wrap}.flow-mini span{font-size:9px;color:#c9b187;border:1px solid #5a4931;border-radius:20px;padding:6px 8px}.chat-mock{height:366px;background:#eae7df;color:#202821;border-radius:10px;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 17px 42px #0009}.chat-head{display:flex;align-items:center;gap:9px;background:#f7f5ef;border-bottom:1px solid #dad7cc;padding:10px 12px}.chat-avatar{background:#276652;color:white;width:29px;height:29px;display:grid;place-items:center;border-radius:50%;font-size:13px;font-weight:700}.chat-head strong{font-size:11px;display:block}.chat-head small{font-size:8px;color:#71817a}.chat-head-more{margin-left:auto}.chat-body{padding:10px 13px;flex:1;background:linear-gradient(125deg,#ebe9e1,#dddcd3);display:flex;flex-direction:column;gap:8px;overflow:hidden}.chat-day{font-size:8px;text-align:center;color:#8b8e86}.bubble{padding:9px 11px;border-radius:9px;max-width:88%;font-size:10px;line-height:1.55;box-shadow:0 2px 4px #0001}.bubble--customer{align-self:flex-end;background:#d7eacf}.bubble--brand{align-self:flex-start;background:white}.chat-input{display:flex;justify-content:space-between;background:#f9f8f5;border-top:1px solid #d1d0c9;padding:11px 13px;color:#999;font-size:10px}.chat-input span{color:#2b8f62;font-size:15px}
/* scheduling */
.schedule-shell{padding:31px 37px 38px;min-height:455px;background:linear-gradient(133deg,#131516,#1e1b17)}.schedule-top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:26px}.schedule-top span{color:#caa767;font-size:9px;letter-spacing:.14em}.schedule-top h3{font-size:24px;letter-spacing:-.05em;margin:8px 0}.schedule-month{font-size:10px!important;letter-spacing:normal!important;padding:10px 14px;border:1px solid #635036;border-radius:8px;white-space:nowrap}.schedule-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:17px}.calendar,.slots{background:#1c1e1f;border:1px solid #423b32;border-radius:10px;padding:20px}.days,.dates{display:grid;grid-template-columns:repeat(7,1fr);text-align:center;gap:5px}.days{font-size:9px;color:#9b9387;margin-bottom:16px}.dates span{display:grid;place-items:center;aspect-ratio:1;font-size:11px;border-radius:7px;color:#efeeea}.dates .dim{color:#626561}.dates .selected{background:#d5a961;color:#16120e;font-weight:800}.slots>strong{font-size:16px}.slots>p{font-size:10px;color:#aaa;margin:4px 0 16px}.slots>div{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:9px;border:1px solid #45433b;border-radius:8px;padding:9px 10px;font-size:12px}.slots b{font-size:9px;color:#d9b66d;font-weight:600}.slots b.taken{color:#9e9c96}.schedule-bottom{display:flex;justify-content:space-between;gap:10px;margin-top:20px;font-size:10px;color:#c8bba4}.schedule-bottom span:before{content:'✓ ';color:#ebc37d}
@media(max-width:900px){.catalog-shell{padding:35px 24px}.catalog-desktop{width:88%}.phone-shell{right:8px}.dashboard-shell{grid-template-columns:108px 1fr}.dash-sidebar{padding-inline:9px}.dash-main{padding:19px}.dash-graphs{grid-template-columns:1.3fr 1fr}.automation-shell{padding:20px 20px 36px;gap:12px}.schedule-shell{padding:27px 20px 35px}.calendar,.slots{padding:13px}}
@media(max-width:610px){.concept{min-height:340px;border-radius:10px}.catalog-shell{min-height:343px;padding:26px 14px 35px}.catalog-desktop{width:88%;transform:rotate(-2deg)}.shop-head{height:35px;padding-inline:10px}.shop-head strong{font-size:15px}.shop-head>span{font-size:6px}.shop-head>b{font-size:9px}.shop-banner{height:91px;padding:14px}.shop-banner strong{font-size:16px}.shop-banner small{font-size:6px}.shop-heading{padding:9px}.shop-heading strong{font-size:10px}.shop-heading span{font-size:6px}.shop-products{padding-inline:8px;gap:4px}.shop-products img{max-height:74px}.shop-products b,.shop-products span{font-size:7px}.phone-shell{top:75px;right:2px;transform:rotate(5deg) scale(.72);transform-origin:top right}.dashboard-shell{grid-template-columns:49px 1fr;min-height:350px}.dash-sidebar{padding:18px 5px;gap:5px}.dash-sidebar strong{font-size:0;margin-bottom:18px}.dash-sidebar strong span{font-size:13px}.dash-sidebar>div{font-size:13px;justify-content:center;padding:7px}.dash-sidebar>div span,.dash-sidebar small{display:none}.dash-main{padding:12px 10px 33px}.dash-header h3{font-size:17px}.dash-header small{font-size:7px}.dash-header>span{font-size:8px}.dash-kpis{gap:4px}.dash-kpis>div{padding:8px}.dash-kpis span{font-size:8px}.dash-kpis strong{font-size:15px}.dash-kpis small{font-size:7px}.dash-graphs{grid-template-columns:1fr}.dash-graph svg{height:80px}.dash-ranking{display:none}.dash-table{padding:9px}.dash-table>div:not(.dash-widget-head){font-size:8px}.automation-shell{grid-template-columns:1fr 1fr;padding:14px 12px 34px;gap:9px;min-height:350px}.flow-label{font-size:7px;margin-bottom:11px}.flow-node{gap:5px;padding:7px 5px}.flow-node>span{width:22px;height:22px;font-size:9px}.flow-node strong{font-size:9px}.flow-node small{font-size:7px}.flow-line{height:10px;margin-left:15px}.flow-mini{gap:4px}.flow-mini span{font-size:7px;padding:5px}.chat-mock{height:295px}.chat-head{padding:8px}.chat-body{padding:8px;gap:5px}.bubble{font-size:8px;padding:6px}.chat-input{font-size:8px}.schedule-shell{padding:18px 10px 38px;min-height:330px}.schedule-top{margin-bottom:11px}.schedule-top h3{font-size:17px}.schedule-top span{font-size:7px}.schedule-month{padding:7px!important;font-size:8px!important}.schedule-grid{grid-template-columns:1fr;gap:9px}.calendar{padding:10px}.days{margin-bottom:6px;font-size:8px}.dates span{font-size:10px;aspect-ratio:auto;padding:4px}.slots{display:none}.schedule-bottom{font-size:8px;flex-wrap:wrap;margin-top:12px}.concept-footnote{font-size:7px!important;left:9px;bottom:6px}}
@media(prefers-reduced-motion:no-preference){.concept{transition:border-color .25s,box-shadow .25s}.concept:hover{border-color:#a68352;box-shadow:0 14px 50px #0005}}
</style>
