{ name === 'boxes' && <><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></> }
{ name === 'qr' && <><path d="M3 9V3h6M15 3h6v6M21 15v6h-6M9 21H3v-6"/><rect x="7" y="7" width="4" height="4"/><path d="M15 7h2v2h-2zM7 15h2v2H7zM15 15v2h2M19 13v2"/></> }
{ name === 'workflow' && <><rect x="2" y="3" width="8" height="6" rx="1"/><rect x="14" y="15" width="8" height="6" rx="1"/><path d="M10 6h4a4 4 0 0 1 4 4v5M14 11l4 4 4-4M10 18H7a3 3 0 0 1-3-3v-3"/></> }
{ name === 'gift' && <><rect x="3" y="9" width="18" height="12" rx="1"/><path d="M2 9h20M12 9v12M12 9c-6-1-7-2.5-6-5 1.6-2.8 6 1.5 6 5ZM12 9c6-1 7-2.5 6-5-1.6-2.8-6 1.5-6 5Z"/></> }
{ name === 'chart' && <><path d="M3 3v18h18M7 16l4-5 3 2 6-7"/><path d="M16 6h4v4"/></> }
{ name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18M8 15l2 2 5-5"/></> }
{ name === 'truck' && <><path d="M2 6h12v11H2zM14 10h4l4 4v3h-8z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></> }
{ name === 'globe' && <><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c-4 4-4 14 0 18M12 3c4 4 4 14 0 18"/></> }
{ name === 'wrench' && <><path d="M14 7a6 6 0 0 0-7 7L3 18a2 2 0 0 0 3 3l4-4a6 6 0 0 0 7-7l-3 3-4-2 1-4 3-3Z"/></> }
{ name === 'sparkles' && <><path d="m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2ZM19 2l.6 2.4L22 5l-2.4.6L19 8l-.6-2.4L16 5l2.4-.6L19 2Z"/></> }
